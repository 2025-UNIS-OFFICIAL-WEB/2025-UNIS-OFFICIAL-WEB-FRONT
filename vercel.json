{
    "cleanUrls": true,
    "rewrites": [
      { "source": "/(api|api/.*)", "destination": "/api/$1" }, 
      { "source": "/assets/(.*)", "destination": "/assets/$1" }, 
      { "source": "/(.*\\..*)", "destination": "/$1" },       
      { "source": "/(.*)", "destination": "/" }               
    ]
  }